{
  "name": "openshifter-web",
  "private": true,
  "version": "0.6.0",
  "description": "Browser tool (WebHID) to update, configure and calibrate a VelocityOne Multi-Shift running OpenShifter",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "firmware": "node scripts/release-firmware.mjs",
    "dev": "node scripts/release-firmware.mjs --optional && vite",
    "build": "npm run firmware && npm run build:site",
    "build:site": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "2.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/w3c-web-hid": "1.0.7",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
