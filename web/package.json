{
  "name": "openshift-web",
  "private": true,
  "version": "0.4.1",
  "description": "Browser tool (WebHID) to update, configure and calibrate a VelocityOne Multi-Shift running OpenShift",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "firmware": "node scripts/copy-firmware.mjs",
    "dev": "node scripts/copy-firmware.mjs --optional && vite",
    "build": "npm run firmware && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@headlessui/react": "2.1.10",
    "@heroicons/react": "2.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/w3c-web-hid": "1.0.7",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
